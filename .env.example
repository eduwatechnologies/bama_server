NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hausabridge

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Audio storage — "local" (dev/disk), "s3" (S3-compatible bucket), or "cloudinary" (Cloudinary CDN)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads/audio
LOCAL_UPLOAD_PUBLIC_URL=http://localhost:4000/uploads/audio
# Only used when STORAGE_DRIVER=s3:
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_URL_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only used when STORAGE_DRIVER=cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=hausabridge/audio
# CLOUDINARY_SECURE_DELIVERY=true

# Seed admin (used only by npm run seed:admin)
SEED_ADMIN_EMAIL=admin@hausabridge.app
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_NAME=Super Admin
